<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>明天也放假 动态密码</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #0c0c0c;
            color: #e0e0e0;
            font-family: 'Courier New', 'Source Code Pro', 'Menlo', monospace;
            padding: 1.5rem 1rem;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }
        .container {
            width: 100%;
            max-width: 500px;
            background: #111;
            border: 1px solid #2a2a2a;
            border-radius: 8px;
            padding: 1.8rem 1.5rem;
            box-shadow: 0 0 20px rgba(0, 255, 255, 0.05);
        }
        hr {
            border: none;
            height: 2px;
            margin: 1.2rem 0;
            background: repeating-linear-gradient(
                to right,
                #00bcd4 0,
                #00bcd4 8px,
                transparent 8px,
                transparent 10px
            );
        }
        .thin-hr {
            background: repeating-linear-gradient(
                to right,
                #4dd0e1 0,
                #4dd0e1 1px,
                transparent 1px,
                transparent 4px
            );
            opacity: 0.4;
        }
        h2 {
            text-align: center;
            font-size: 1.4rem;
            color: #00bcd4;
            margin-bottom: 0.8rem;
            letter-spacing: 2px;
        }
        .section-label {
            color: #ffc107;
            font-weight: bold;
            margin: 1.2rem 0 0.3rem;
            font-size: 1rem;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            padding: 0.2rem 0;
            font-size: 0.95rem;
        }
        .info-row .label {
            color: #888;
            white-space: nowrap;
        }
        .info-row .value {
            color: #ffffff;
            font-weight: bold;
        }
        .input-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin: 1rem 0 0.8rem;
        }
        .input-group input {
            background: #1e1e1e;
            border: 1px solid #00bcd4;
            color: #e0e0e0;
            padding: 0.6rem 1rem;
            font-size: 1.1rem;
            font-family: inherit;
            border-radius: 4px;
            outline: none;
            transition: border 0.2s;
        }
        .input-group input:focus {
            border-color: #ffc107;
        }
        .input-group small {
            color: #777;
            font-size: 0.75rem;
        }
        .btn {
            background: #00bcd4;
            color: #000;
            font-weight: bold;
            border: none;
            padding: 0.6rem 1rem;
            border-radius: 4px;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s;
            letter-spacing: 1px;
        }
        .btn:hover {
            background: #0097a7;
        }

        /* 密码框：左、上、下有边框，右侧无边框，密码居中 */
        .password-box {
            margin: 0.8rem 0;
            border-left: 3px solid;
            border-top: 3px solid;
            border-bottom: 3px solid;
            border-right: none;   /* 去掉右侧竖线 */
            padding: 1rem 0.5rem;
            text-align: center;
            font-size: 1.9rem;
            font-weight: bold;
            letter-spacing: 6px;
            background: #1a1a1a;
            border-radius: 4px 0 0 4px;
            word-break: break-all;
        }
        .password-current {
            color: #4caf50;
            border-color: #4caf50;
        }
        .password-previous {
            color: #ffc107;
            border-color: #ffc107;
            font-size: 1.6rem;
            letter-spacing: 4px;
        }
        .tips {
            color: #aaa;
            font-size: 0.85rem;
            line-height: 1.6;
            margin-top: 0.8rem;
        }
        .tips li {
            margin-left: 1.2rem;
            list-style-type: decimal;
        }
        .error {
            color: #f44336;
            font-weight: bold;
            background: #2b1111;
            border: 1px solid #f44336;
            padding: 0.5rem;
            border-radius: 4px;
            margin: 1rem 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>⏳ 明天也放假 动态密码</h2>
        <hr>
        
        <div class="section-label">▶ 管理员信息</div>
        <div class="info-row">
            <span class="label">管理员ID：</span>
            <span class="value" id="operatorIdDisplay">——</span>
        </div>
        <div class="info-row">
            <span class="label">剩余刷新：</span>
            <span class="value" id="remainTimeDisplay" style="color:#ffc107;">——</span>
        </div>
        
        <div class="section-label">▶ 动态密码</div>
        <div class="password-box password-current" id="currentPasswordBox">————</div>
        <div class="password-box password-previous" id="previousPasswordBox">————</div>
        
        <div class="section-label">▶ 设置</div>
        <div class="input-group">
            <input type="number" id="operatorIdInput" placeholder="请输入管理员 ID（纯数字）" inputmode="numeric">
            <input type="number" id="timestampInput" placeholder="可选：指定时间戳（留空=当前时间）" inputmode="numeric">
            <button class="btn" id="generateBtn">🔄 生成密码</button>
            <small>💡 输入管理员ID后点击生成，或直接回车</small>
        </div>
        
        <div id="errorMsg" class="error" style="display: none;"></div>
        
        <hr class="thin-hr">
        <div class="tips">
            <strong>使用提示：</strong>
            <ol>
                <li>确保手机时间与服务器精确同步</li>
                <li>仅对应管理员ID的逻辑服可用</li>
                <li>若密码依然错误，请检查ID是否输入正确</li>
                <li>密钥固定内置，勿随意分享给不可信的人</li>
            </ol>
        </div>
        <hr>
        <div style="text-align:center; color:#555; font-size:0.75rem; margin-top:0.5rem;">
            CheatKVManager Web v1.0
        </div>
    </div>

    <script>
        (function() {
            // ========== 配置常量（与Shell版完全一致） ==========
            const SECRET = 894268258;
            const PERIOD = 300;
            const DIGITS = 8;
            const MOD = 2147483647;

            // ========== DOM 元素 ==========
            const operatorInput = document.getElementById('operatorIdInput');
            const timestampInput = document.getElementById('timestampInput');
            const generateBtn = document.getElementById('generateBtn');
            const errorDiv = document.getElementById('errorMsg');
            const operatorDisplay = document.getElementById('operatorIdDisplay');
            const remainDisplay = document.getElementById('remainTimeDisplay');
            const currentBox = document.getElementById('currentPasswordBox');
            const previousBox = document.getElementById('previousPasswordBox');

            let currentOperatorId = null;
            let timerInterval = null;

            // ========== 从 Shell 逐行翻译的工具函数 ==========
            function pow10Int(n) {
                let r = 1;
                for (let i = 0; i < n; i++) {
                    r *= 10;
                }
                return r;
            }

            function mixNumber(h, v) {
                h = ((h % MOD) + MOD) % MOD;
                v = ((v % MOD) + MOD) % MOD;
                if (h <= 0) h = 1;
                h = ((h * 131542 + v * 265443 + 97531) % MOD);
                h = ((h * 524287 + (v % 1000003) * 8191 + 104729) % MOD);
                h = ((h * 97 + Math.floor(h / 7) + (v % 1000033) * 193 + 65537) % MOD);
                h = ((h * 1009 + (v % 999983) * 9176 + Math.floor(h / 11) + 314159) % MOD);
                return ((h % MOD) + MOD) % MOD;
            }

            function makePasswordByDigits(hashValue, digits) {
                if (digits < 6) digits = 6;
                if (digits > 9) digits = 9;
                const minValue = pow10Int(digits - 1);
                const range = minValue * 9;
                let n = ((hashValue % range) + range) % range;
                n = n + minValue;
                return n;
            }

            function buildDynamicPasswordHash(timeSlot, secret, operatorId) {
                if (secret <= 0) secret = 846291573;
                if (operatorId < 0) operatorId = 0;
                let h = 911382323;
                h = mixNumber(h, secret);
                h = mixNumber(h, timeSlot);
                h = mixNumber(h, operatorId);
                h = mixNumber(h, PERIOD);
                h = mixNumber(h, secret % 1000003);
                h = mixNumber(h, timeSlot % 1000003);
                h = mixNumber(h, operatorId % 1000003);

                const secretA = secret % 2147483;
                const secretB = (Math.floor(secret / 7)) % 2147483;
                const secretC = (Math.floor(secret / 97)) % 2147483;
                const secretD = (Math.floor(secret / 997)) % 2147483;

                const slotA = timeSlot % 2147483;
                const slotB = (Math.floor(timeSlot / 3)) % 2147483;
                const slotC = (Math.floor(timeSlot / 17)) % 2147483;
                const slotD = (Math.floor(timeSlot / 101)) % 2147483;

                const operatorA = operatorId % 2147483;
                const operatorB = (Math.floor(operatorId / 3)) % 2147483;
                const operatorC = (Math.floor(operatorId / 17)) % 2147483;
                const operatorD = (Math.floor(operatorId / 101)) % 2147483;

                h = mixNumber(h, (secretA + slotD * 31 + operatorC * 47 + 13579));
                h = mixNumber(h, (secretB + slotC * 37 + operatorD * 53 + 24680));
                h = mixNumber(h, (secretC + slotB * 41 + operatorA * 59 + 97531));
                h = mixNumber(h, (secretD + slotA * 43 + operatorB * 61 + 86420));
                h = mixNumber(h, (secretA + operatorA + 205128));
                h = mixNumber(h, (secretB + operatorB + 763320));
                h = mixNumber(h, (secretC + operatorC + 467285));
                h = mixNumber(h, (secretD + operatorD + 728577));

                for (let i = 1; i <= 12; i++) {
                    const roundA = (secretA + i * 7919 + slotA * 17 + operatorD * 31) % MOD;
                    const roundB = (secretB + i * 104729 + slotB * 19 + operatorC * 37) % MOD;
                    const roundC = (secretC + i * 65537 + slotC * 23 + operatorB * 41) % MOD;
                    const roundD = (secretD + i * 32749 + slotD * 29 + operatorA * 43) % MOD;
                    h = mixNumber(h, roundA);
                    h = mixNumber(h, roundB);
                    h = mixNumber(h, roundC);
                    h = mixNumber(h, roundD);
                    h = mixNumber(h, (h % 1000003) + secretA + slotA + operatorA + i * 97);
                    h = mixNumber(h, (h % 999983) + secretB + slotB + operatorB + i * 193);
                    h = mixNumber(h, (h % 999979) + secretC + slotC + operatorC + i * 389);
                }

                h = mixNumber(h, secretA + secretC + slotB + operatorD + 205128);
                h = mixNumber(h, secretB + secretD + slotC + operatorC + 763320);
                h = mixNumber(h, operatorA + operatorC + secretD + slotA + 205128);
                h = mixNumber(h, operatorB + operatorD + secretC + slotD + 728577);
                h = mixNumber(h, h + secretA + secretB + secretC + secretD);
                h = mixNumber(h, h + slotA + slotB + slotC + slotD);
                h = mixNumber(h, h + operatorA + operatorB + operatorC + operatorD);

                return ((h % MOD) + MOD) % MOD;
            }

            function getPasswordByOffset(now, offset, operatorId) {
                let timeSlot = Math.floor(now / PERIOD) + offset;
                if (timeSlot < 0) timeSlot = 0;
                const hashValue = buildDynamicPasswordHash(timeSlot, SECRET, operatorId);
                const password = makePasswordByDigits(hashValue, DIGITS);
                return { timeSlot, password };
            }

            function formatTime(seconds) {
                const mins = Math.floor(seconds / 60);
                const secs = seconds % 60;
                if (mins > 0) {
                    return `${mins}分${secs}秒`;
                }
                return `${secs}秒`;
            }

            // ========== 更新界面 ==========
            function updateDisplay() {
                if (currentOperatorId === null || isNaN(currentOperatorId)) {
                    return;
                }
                const operatorId = currentOperatorId;
                let now;
                const tsInput = timestampInput.value.trim();
                if (tsInput !== '') {
                    now = parseInt(tsInput, 10);
                    if (isNaN(now)) {
                        showError('时间戳格式错误，必须是纯数字');
                        return;
                    }
                } else {
                    now = Math.floor(Date.now() / 1000);
                }

                const current = getPasswordByOffset(now, 0, operatorId);
                const previous = getPasswordByOffset(now, -1, operatorId);

                const slotStart = current.timeSlot * PERIOD;
                const slotEnd = slotStart + PERIOD;
                let remainSeconds = slotEnd - now;
                if (remainSeconds < 0) remainSeconds = 0;

                operatorDisplay.textContent = operatorId;
                remainDisplay.textContent = formatTime(remainSeconds);
                currentBox.textContent = current.password;
                previousBox.textContent = previous.password;

                hideError();
            }

            // ========== 验证并开始 ==========
            function startGeneration() {
                const idRaw = operatorInput.value.trim();
                if (idRaw === '') {
                    showError('请输入管理员ID');
                    return;
                }
                const id = parseInt(idRaw, 10);
                if (isNaN(id) || id.toString() !== idRaw || id < 0) {
                    showError('管理员ID必须是纯数字（非负整数）');
                    return;
                }
                currentOperatorId = id;
                updateDisplay();

                // 清除旧定时器
                if (timerInterval) clearInterval(timerInterval);
                // 每秒刷新一次（时间戳留空时自动更新倒计时，时间戳填写时保持不变）
                timerInterval = setInterval(() => {
                    if (timestampInput.value.trim() === '') {
                        updateDisplay();
                    }
                }, 1000);
            }

            function showError(msg) {
                errorDiv.style.display = 'block';
                errorDiv.textContent = '⚠️ ' + msg;
            }

            function hideError() {
                errorDiv.style.display = 'none';
            }

            // ========== 事件绑定 ==========
            generateBtn.addEventListener('click', startGeneration);
            operatorInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    startGeneration();
                }
            });
            timestampInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    startGeneration();
                }
            });

            // 如果输入时间戳后自动更新一次显示
            timestampInput.addEventListener('input', () => {
                if (currentOperatorId !== null) {
                    updateDisplay();
                }
            });

        })();
    </script>
</body>
</html>
